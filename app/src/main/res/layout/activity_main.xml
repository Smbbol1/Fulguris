<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Don't put a background here as it breaks our status bar color -->
    <!-- animateLayoutChanges removed: CoordinatorLayout uses custom child drawing order
         (getChildDrawingOrder / mOrderedChildren) for its Behavior system. Having
         animateLayoutChanges="true" here creates a race condition where LayoutTransition
         can corrupt the drawing order cache during cascading layout passes from tab
         animations, causing IndexOutOfBoundsException in dispatchTouchEvent
         (getChildDrawingOrder returns stale index >= childCount). This attribute is
         also a no-op: the root CoordinatorLayout's direct children (DrawerLayout,
         cursorOverlayHost) never change visibility or get added/removed, so
         LayoutTransition never fires. The actual toolbar/tab animations are handled
         by the nested LinearLayouts which have their own animateLayoutChanges="true". -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="fulguris.activity.WebBrowserActivity"

        android:fitsSystemWindows="true">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:id="@+id/ui_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="?android:attr/colorBackground"
                android:animateLayoutChanges="true">

                <include android:id="@+id/toolbar_include"
                    layout="@layout/toolbar"/>

                <LinearLayout
                    android:id="@+id/layoutHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="?android:attr/colorBackground"
                    android:animateLayoutChanges="true">

                    <LinearLayout
                        android:id="@+id/layoutTabsLeft"
                        android:layout_width="@dimen/vertical_tab_width"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:orientation="vertical"
                        android:background="?android:attr/colorBackground"
                        tools:background="?attr/colorError"
                        android:animateLayoutChanges="true"
                        tools:visibility="visible">

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutPageContainer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="?android:attr/colorBackground"
                        android:animateLayoutChanges="true">

                        <include android:id="@+id/findInPageInclude" layout="@layout/search_interface"/>

                        <!--
                        FrameLayout needed to animate our tabs.
                        We keep swapping both PullRefreshLayout to perform smooth flicker free tab animations.
                        We switched from a FrameLayout to a CoordinatorLayout to be able to display snackbar within our WebView.
                        -->
                        <androidx.coordinatorlayout.widget.CoordinatorLayout
                            android:id="@+id/web_view_frame"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:animateLayoutChanges="false">

                            <fulguris.view.PullRefreshLayout
                                android:id="@+id/tabViewContainerOne"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?android:attr/colorBackground"
                                android:clipChildren="true"
                                android:animateLayoutChanges="false" />

                            <fulguris.view.PullRefreshLayout
                                android:id="@+id/tabViewContainerTwo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?android:attr/colorBackground"
                                android:clipChildren="true"
                                android:animateLayoutChanges="false" />

                            <!--
                            Empty state shown when there is no tab open (the last one was
                            closed): the large Fulguris logo on the empty background, as on
                            the onboarding first screen. The address field (focused) is the
                            way to get back in by typing a URL or search.
                            -->
                            <FrameLayout
                                android:id="@+id/emptyTabsView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?android:attr/colorBackground"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <ImageView
                                    android:layout_width="240dp"
                                    android:layout_height="240dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_lightning_large"
                                    android:importantForAccessibility="no" />
                            </FrameLayout>

                            <include layout="@layout/touch_tab_switcher"
                                android:id="@+id/fabInclude" />

                            <LinearLayout
                                android:id="@+id/notepadContainer"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#1E222A"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="46dp"
                                    android:background="#161920"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="6dp">

                                    <HorizontalScrollView
                                        android:id="@+id/notepadTabsScroll"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:scrollbars="none">

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="match_parent"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <LinearLayout
                                                android:id="@+id/notepadTabsContainer"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:gravity="center_vertical"
                                                android:orientation="horizontal" />

                                            <TextView
                                                android:id="@+id/notepadBtnAddTab"
                                                android:layout_width="32dp"
                                                android:layout_height="32dp"
                                                android:layout_marginStart="4dp"
                                                android:background="#252A34"
                                                android:gravity="center"
                                                android:text="+"
                                                android:textColor="#A3BE8C"
                                                android:textSize="17sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/notepadStatusTitle"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:paddingStart="8dp"
                                                android:text="0L"
                                                android:textColor="#636D83"
                                                android:textSize="11sp" />
                                        </LinearLayout>
                                    </HorizontalScrollView>

                                    <TextView
                                        android:id="@+id/notepadBtnKeyboard"
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:gravity="center"
                                        android:text="⌨"
                                        android:textColor="#636D83"
                                        android:textSize="17sp" />

                                    <ImageButton
                                        android:id="@+id/notepadBtnSearch"
                                        style="?android:attr/actionButtonStyle"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:contentDescription="Buscar bloque"
                                        android:tint="#D8DEE9"
                                        app:srcCompat="@drawable/ic_find_in_page" />

                                    <ImageButton
                                        android:id="@+id/notepadBtnPaste"
                                        style="?android:attr/actionButtonStyle"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:contentDescription="Pegar o reemplazar selección"
                                        android:tint="#A3BE8C"
                                        app:srcCompat="@drawable/ic_script_add" />

                                    <ImageButton
                                        android:id="@+id/notepadBtnUndo"
                                        style="?android:attr/actionButtonStyle"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:contentDescription="Deshacer"
                                        android:tint="#D8DEE9"
                                        app:srcCompat="@drawable/ic_action_back" />

                                    <ImageButton
                                        android:id="@+id/notepadBtnCopyAll"
                                        style="?android:attr/actionButtonStyle"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:contentDescription="Copiar todo"
                                        android:tint="#88C0D0"
                                        app:srcCompat="@drawable/ic_tabs" />

                                    <ImageButton
                                        android:id="@+id/notepadBtnClear"
                                        style="?android:attr/actionButtonStyle"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:contentDescription="Limpiar nota actual"
                                        android:tint="#BF616A"
                                        app:srcCompat="@drawable/ic_delete_forever" />

                                    <ImageButton
                                        android:id="@+id/notepadBtnClose"
                                        style="?android:attr/actionButtonStyle"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:contentDescription="Volver a pestaña"
                                        android:tint="#D8DEE9"
                                        app:srcCompat="@drawable/ic_action_delete" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/notepadSearchBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="#252A34"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp"
                                    android:visibility="gone">

                                    <EditText
                                        android:id="@+id/notepadSearchInput"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:background="@null"
                                        android:fontFamily="monospace"
                                        android:hint="Pega o escribe el bloque a buscar..."
                                        android:inputType="textMultiLine|textNoSuggestions"
                                        android:maxLines="4"
                                        android:padding="6dp"
                                        android:textColor="#D8DEE9"
                                        android:textColorHint="#636D83"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:id="@+id/notepadSearchCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="6dp"
                                        android:textColor="#E5C07B"
                                        android:textSize="11sp" />

                                    <ImageButton
                                        android:id="@+id/notepadSearchPrev"
                                        style="?android:attr/actionButtonStyle"
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:tint="#D8DEE9"
                                        app:srcCompat="@drawable/ic_action_back" />

                                    <ImageButton
                                        android:id="@+id/notepadSearchNext"
                                        style="?android:attr/actionButtonStyle"
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:tint="#D8DEE9"
                                        app:srcCompat="@drawable/ic_action_forward" />
                                </LinearLayout>

                                <HorizontalScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:fillViewport="true">

                                    <ScrollView
                                        android:id="@+id/notepadScrollView"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:fillViewport="true">

                                        <EditText
                                            android:id="@+id/notepadEditText"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:background="@null"
                                            android:cursorVisible="true"
                                            android:fontFamily="monospace"
                                            android:gravity="top|start"
                                            android:hint="Usa el icono + verde arriba para pegar tu código (pulsa ⌨ para activar teclado)..."
                                            android:imeOptions="flagNoExtractUi"
                                            android:inputType="textMultiLine|textNoSuggestions"
                                            android:minWidth="360dp"
                                            android:padding="12dp"
                                            android:scrollHorizontally="true"
                                            android:textColor="#D8DEE9"
                                            android:textColorHighlight="#55E5C07B"
                                            android:textColorHint="#636D83"
                                            android:textIsSelectable="true"
                                            android:textSize="12.5sp" />
                                    </ScrollView>
                                </HorizontalScrollView>

                            </LinearLayout>

                        </androidx.coordinatorlayout.widget.CoordinatorLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutTabsRight"
                        android:layout_width="@dimen/vertical_tab_width"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:orientation="vertical"
                        android:background="?android:attr/colorBackground"
                        tools:background="?attr/colorError"
                        android:animateLayoutChanges="true">

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!--
            - android:clickable="true":
            Needed to fix click through issues.
            See: https://github.com/Slion/Fulguris/issues/290
            -->
            <FrameLayout
                android:id="@+id/left_drawer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="?android:attr/colorBackground"
                android:fitsSystemWindows="true"
                android:weightSum="1"
                android:layout_marginLeft="-64dp"
                android:clickable="true" >

                <!--  We added the content for cutout support to be able to set margins conveniently -->
                <FrameLayout
                    android:id="@+id/leftDrawerContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/colorBackground" />

            </FrameLayout>

            <!--
            - android:clickable="true":
            Needed to fix click through issues.
            See: https://github.com/Slion/Fulguris/issues/290
            -->
            <FrameLayout
                android:id="@+id/right_drawer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?android:attr/colorBackground"
                android:fitsSystemWindows="true"
                android:weightSum="1"
                android:layout_marginLeft="-64dp"
                android:clickable="true">

                <!--  We added the content for cutout support to be able to set margins conveniently -->
                <FrameLayout
                    android:id="@+id/rightDrawerContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/colorBackground" />

            </FrameLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <!-- Android TV cursor overlay, controlled by fulguris.cursor.CursorController.
             The CursorView is transparent and non-focusable and spans the WHOLE activity (toolbar
             AND web view, even over the drawers) so the cursor can be used over the toolbar as
             well as the page. It lives in a plain FrameLayout host (match_parent, the last/top
             child of the root CoordinatorLayout) rather than directly in the CoordinatorLayout:
             on some devices/Android versions removing a direct CoordinatorLayout child can leave
             the child's parent reference stale, making a later re-parent (fullscreen) throw
             "already has a parent"; a plain FrameLayout parent repars reliably. While an HTML5
             video is fullscreen the activity re-parents the CursorView into the fullscreen
             container (which sits on the decor view, above this one) instead. -->
        <FrameLayout
            android:id="@+id/cursorOverlayHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

            <fulguris.cursor.CursorView
                android:id="@+id/cursorOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:visibility="gone" />
        </FrameLayout>




    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
